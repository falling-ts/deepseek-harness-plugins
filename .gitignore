# IDE
.idea/

# Runtime logs (harness-server.sh writes dsh-web-<port>.log to the current directory)
*.log

# Raw QQ chat captures — kept only in the plugin's assets/, not the workspace root
QQ*.png

# Session-local agent state (daily work logs, caches). Project-related, but not
# something the shared repo should carry — and `git add .` would otherwise sweep it.
.workbuddy/

# A stray DSH_HOME that a dev instance created in the workspace root (profiles,
# sessions, credentials). Runtime state, never shared.
.dsh-home/

# cmd-menu-probe.mjs dumps the whole rendered body for eyeballing; the PNG next
# to it is the artifact worth keeping.
exploration/cmd-menu-*.html
